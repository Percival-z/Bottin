# Copiá este archivo a `.env` y completá con tus valores reales.
# Nunca subas el archivo .env al repositorio.

# Token de tu bot de Telegram (lo da @BotFather)
TELEGRAM_TOKEN=

# Clave de la API de Google Gemini
GEMINI_API_KEY=

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-3.5-flash-lite

# Clave de la API-Football (api-sports.io)
FOOTBALL_API_KEY=
